{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xeind-net",
  // No account_id: a Pages config rejects the key and the Git build fails.
  // The deploy script in package.json pins the account instead.
  "compatibility_date": "2026-07-15",
  "pages_build_output_dir": "./dist",
}
