---
import { CSS_TRANSITIONS } from "@/lib/config/animation";

interface Props {
  href: string;
  label: string;
  shortcut: string;
}

const { href, label, shortcut } = Astro.props;

/* Astro templates take a style string, not React's style object, so serialize
   the shared transitions rather than retyping their numbers here. */
const css = (t: { transitionDuration: string; transitionTimingFunction: string }) =>
  `transition-duration:${t.transitionDuration};transition-timing-function:${t.transitionTimingFunction}`;
const t = css(CSS_TRANSITIONS.border);
const tFast = css(CSS_TRANSITIONS.fade);
---

<a
  href={href}
  class="bg-card group focus-visible:ring-accent focus-visible:ring-offset-background relative inline-flex items-center justify-center gap-3 px-4 py-2 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none md:px-12"
  style={t}
>
  <div
    class="border-accent/30 absolute top-0 right-0 left-0 border-t border-dashed transition-all group-hover:border-solid"
    style={t}
  >
  </div>
  <div
    class="border-accent/30 absolute top-0 right-0 bottom-0 border-r border-dashed transition-all group-hover:border-solid"
    style={t}
  >
  </div>
  <div
    class="border-accent/30 absolute right-0 bottom-0 left-0 border-b border-dashed transition-all group-hover:border-solid"
    style={t}
  >
  </div>
  <div
    class="border-accent/30 absolute top-0 bottom-0 left-0 border-l border-dashed transition-all group-hover:border-solid"
    style={t}
  >
  </div>
  {/* Corner brackets */}
  <div class="absolute top-0 left-0 z-10">
    <div class="bg-accent group-hover:bg-tertiary h-px w-2 transition-all" style={t}></div><div
      class="bg-accent group-hover:bg-tertiary h-2 w-px transition-all"
      style={t}
    >
    </div>
  </div>
  <div class="absolute top-0 right-0 z-10">
    <div class="bg-accent group-hover:bg-tertiary ml-auto h-px w-2 transition-all" style={t}>
    </div><div class="bg-accent group-hover:bg-tertiary ml-auto h-2 w-px transition-all" style={t}>
    </div>
  </div>
  <div class="absolute bottom-0 left-0 z-10">
    <div class="bg-accent group-hover:bg-tertiary h-2 w-px transition-all" style={t}></div><div
      class="bg-accent group-hover:bg-tertiary h-px w-2 transition-all"
      style={t}
    >
    </div>
  </div>
  <div class="absolute right-0 bottom-0 z-10">
    <div class="bg-accent group-hover:bg-tertiary ml-auto h-2 w-px transition-all" style={t}>
    </div><div class="bg-accent group-hover:bg-tertiary ml-auto h-px w-2 transition-all" style={t}>
    </div>
  </div>
  {/* Gradient overlays */}
  <div class="pointer-events-none absolute inset-0">
    <div
      class="bg-accent/20 absolute inset-0 transition-opacity group-hover:opacity-0 group-active:opacity-0"
      style={`mask-image:linear-gradient(to right, transparent 0%, rgba(0,0,0,0.15) 12.5%, rgba(0,0,0,0.40) 32.5%, rgba(0,0,0,0.60) 50%, rgba(0,0,0,0.40) 67.5%, rgba(0,0,0,0.15) 87.5%, transparent 100%);-webkit-mask-image:linear-gradient(to right, transparent 0%, rgba(0,0,0,0.15) 12.5%, rgba(0,0,0,0.40) 32.5%, rgba(0,0,0,0.60) 50%, rgba(0,0,0,0.40) 67.5%, rgba(0,0,0,0.15) 87.5%, transparent 100%);${t}`}
    >
    </div>
    <div
      class="bg-tertiary/10 absolute inset-0 opacity-0 transition-opacity group-hover:opacity-(--surface-hover-fill) group-active:opacity-0"
      style={t}
    >
    </div>
    <div
      class="bg-tertiary/10 absolute inset-0 opacity-0 transition-opacity group-active:opacity-100"
      style={`mask-image:linear-gradient(to right, rgba(0,0,0,0.60) 0%, rgba(0,0,0,0.60) 12.5%, rgba(0,0,0,0.40) 32.5%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.40) 67.5%, rgba(0,0,0,0.60) 87.5%, rgba(0,0,0,0.60) 100%);-webkit-mask-image:linear-gradient(to right, rgba(0,0,0,0.60) 0%, rgba(0,0,0,0.60) 12.5%, rgba(0,0,0,0.40) 32.5%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.40) 67.5%, rgba(0,0,0,0.60) 87.5%, rgba(0,0,0,0.60) 100%);${tFast}`}
    >
    </div>
  </div>
  {
    /* 24px label line + py-2 = a 40px control, whole half-cells top to
      bottom; the 24px shortcut chip centres inside the same line box. */
  }
  <span class="relative z-10 font-serif text-sm leading-6" style={t}>{label}</span>
  <span
    class="bg-accent/10 group-hover:ring-tertiary/30 ring-accent/30 relative z-10 px-2 py-1 font-mono text-xs leading-4 text-(--badge-ink) ring-1 transition-all group-hover:text-(--badge-hover-ink)"
    style={t}>{shortcut}</span
  >
</a>
