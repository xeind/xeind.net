---
import ColorSchemePreview from "./ColorSchemePreview.astro";
import { CSS_TRANSITIONS } from "@/lib/config/animation";

/* The theme picker: a quiet button that opens a four-row menu.
   Rendered in the Footer and on /design, so the menu carries no `id` — the
   script finds it as the trigger's sibling. Two copies on one page would
   otherwise collide on the same `popovertarget`. */
const houseTransition = `transition-duration:${CSS_TRANSITIONS.border.transitionDuration};transition-timing-function:${CSS_TRANSITIONS.border.transitionTimingFunction}`;

const themes = [
  { value: "dark", label: "Manila" },
  { value: "light", label: "Kozo" },
  { value: "nightingale", label: "Nightingale" },
  { value: "blueprint", label: "Blueprint" },
] as const;
---

<div class="relative inline-flex">
  <button
    type="button"
    data-theme-select
    data-hero-sfx="click"
    aria-haspopup="menu"
    aria-expanded="false"
    class="border-accent/30 bg-card text-foreground hover:bg-muted hover:border-accent/50 focus-visible:ring-accent relative inline-flex min-h-8 items-center gap-2 border border-dashed px-4 py-1.5 font-mono text-xs transition-colors select-none focus-visible:ring-2 focus-visible:outline-none"
    style={houseTransition}
  >
    <span class="sr-only">Theme:</span>
    {
      /* Chip and name roll as one value: two faces stacked in each masked box,
        both boxes driven by the same class toggle, so nothing in the button
        changes on its own timing. The chip has to be pinned to a scheme while
        it leaves — left to follow the document it would repaint the instant
        the theme flipped, halfway out of the mask. */
    }
    <span class="theme-roll inline-grid h-4 w-4 overflow-clip">
      <span class="col-start-1 row-start-1" data-roll-out aria-hidden="true">
        <ColorSchemePreview />
      </span>
      <span class="col-start-1 row-start-1" data-roll-in>
        <ColorSchemePreview />
      </span>
    </span>
    {
      /* The invisible four size the box to the longest name, which is what
        keeps the button and the panel the same width. */
    }
    <span class="theme-roll inline-grid h-4 overflow-clip text-left leading-4">
      {
        themes.map((theme) => (
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">
            {theme.label}
          </span>
        ))
      }
      <span class="col-start-1 row-start-1" data-roll-out aria-hidden="true"></span>
      <span class="col-start-1 row-start-1" data-roll-in data-theme-label>Manila</span>
    </span>
  </button>

  <div
    popover
    data-theme-menu
    role="menu"
    aria-label="Theme"
    class="theme-menu border-accent/30 bg-card border border-dashed"
  >
    {
      themes.map((theme) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-option={theme.value}
          data-hero-sfx="click"
          class="text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:ring-accent flex min-h-8 w-full items-center gap-2 px-4 text-left font-mono text-xs transition-colors select-none focus-visible:ring-1 focus-visible:outline-none focus-visible:ring-inset"
        >
          <ColorSchemePreview theme={theme.value} />
          <span>{theme.label}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  type ThemeName = "dark" | "light" | "nightingale" | "blueprint";
  const themes: ThemeName[] = ["dark", "light", "nightingale", "blueprint"];
  const labels = {
    dark: "Manila",
    light: "Kozo",
    nightingale: "Nightingale",
    blueprint: "Blueprint",
  } satisfies Record<ThemeName, string>;

  function isThemeName(value: string | null): value is ThemeName {
    return value !== null && themes.includes(value as ThemeName);
  }

  function savedTheme(): ThemeName {
    const saved = localStorage.getItem("theme");
    return isThemeName(saved) ? saved : "dark";
  }

  /* Paint the label and the row marks from whatever theme is stored. The head
     script in Layout.astro owns the document attribute on first paint and
     across ClientRouter swaps; this only reflects it in the control. */
  const schemeClasses = {
    dark: "scheme-dark",
    light: "scheme-light",
    nightingale: "scheme-nightingale",
    blueprint: "scheme-blueprint",
  } satisfies Record<ThemeName, string>;

  function paintChip(face: HTMLElement, theme: ThemeName) {
    const chip = face.querySelector<HTMLElement>(".scheme-preview");
    if (!chip) return;
    chip.classList.remove(...Object.values(schemeClasses));
    chip.classList.add(schemeClasses[theme]);
  }

  /* Move the trigger's faces to the next theme. The one leaving drops out of
     the mask, the one arriving falls in from above. Both states live in
     `.theme-roll` in global.css; the script only has to write the faces, hold
     the start position for one frame without a transition, and let go. */
  function roll(trigger: HTMLElement, from: ThemeName, to: ThemeName) {
    const boxes = [...trigger.querySelectorAll<HTMLElement>(".theme-roll")];
    boxes.forEach((box) => {
      const leaving = box.querySelector<HTMLElement>("[data-roll-out]");
      const arriving = box.querySelector<HTMLElement>("[data-roll-in]");
      if (!leaving || !arriving) return;
      if (arriving.matches("[data-theme-label]")) {
        leaving.textContent = arriving.textContent;
        arriving.textContent = labels[to];
      } else {
        paintChip(leaving, from);
        paintChip(arriving, to);
      }
    });
    boxes.forEach((box) => box.classList.add("is-entering", "is-instant"));
    void trigger.offsetWidth;
    boxes.forEach((box) => box.classList.remove("is-entering", "is-instant"));
  }

  /* `animate` is false on first paint and after a ClientRouter swap — the name
     has not changed there, it is only being written into a fresh document. */
  function syncTheme(animate = false) {
    const theme = savedTheme();
    document.querySelectorAll<HTMLElement>("[data-theme-select]").forEach((trigger) => {
      const label = trigger.querySelector<HTMLElement>("[data-theme-label]");
      if (!label || label.textContent === labels[theme]) return;
      const from = (Object.keys(labels) as ThemeName[]).find(
        (name) => labels[name] === label.textContent,
      );
      if (animate && from) {
        roll(trigger, from, theme);
      } else {
        label.textContent = labels[theme];
        const arriving = trigger.querySelector<HTMLElement>("[data-roll-in]");
        if (arriving) paintChip(arriving, theme);
      }
    });
    document.querySelectorAll<HTMLElement>("[data-theme-option]").forEach((el) => {
      const selected = el.dataset.themeOption === theme;
      el.setAttribute("aria-checked", String(selected));
    });
  }

  function applyTheme(theme: ThemeName) {
    if (theme === "light") document.documentElement.removeAttribute("data-theme");
    else document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    syncTheme(true);
  }

  function menuOf(trigger: Element) {
    return trigger.parentElement?.querySelector<HTMLElement>("[data-theme-menu]") ?? null;
  }

  function triggerOf(menu: Element) {
    return menu.parentElement?.querySelector<HTMLElement>("[data-theme-select]") ?? null;
  }

  /* The menu lives in the top layer, so it escapes the footer's -z-10 and
     needs its own coordinates. Below the trigger when there is room, above it
     otherwise — the footer sits at the bottom of the viewport. */
  function place(menu: HTMLElement) {
    const trigger = triggerOf(menu);
    if (!trigger) return;
    const rect = trigger.getBoundingClientRect();
    const fitsBelow = window.innerHeight - rect.bottom >= menu.offsetHeight + 8;
    const top = fitsBelow ? rect.bottom + 8 : rect.top - menu.offsetHeight - 8;
    /* Anchored on the right edge, not the left: the panel is as wide as
       "Nightingale" needs and the trigger is only as wide as the theme it is
       showing, so the two can share one edge but not both. The picker is
       right-aligned furniture in the footer and in the /design header, so the
       right edge is the one that reads as the rail. */
    /* Set through `left`, not `right`: this panel's containing block is not the
       viewport, so a right offset measured off the window landed it 15px
       inside the trigger. Subtracting its own width works in the same
       coordinate space getBoundingClientRect reports. */
    menu.style.left = `${Math.round(rect.right - menu.offsetWidth)}px`;
    /* Scale from the trigger, not from the panel's middle (animation.md §2).
       The panel hangs off the trigger's right edge, so the origin is the right
       corner on whichever side it opened. */
    menu.style.transformOrigin = fitsBelow ? "100% 0" : "100% 100%";
    menu.style.top = `${Math.round(top)}px`;
  }

  function openMenu(menu: HTMLElement) {
    menu.showPopover();
    place(menu);
    const checked = menu.querySelector<HTMLElement>('[aria-checked="true"]');
    (checked ?? menu.querySelector<HTMLElement>("[data-theme-option]"))?.focus();
  }

  function moveFocus(menu: HTMLElement, from: Element, step: number) {
    const items = [...menu.querySelectorAll<HTMLElement>("[data-theme-option]")];
    const next = items[(items.indexOf(from as HTMLElement) + step + items.length) % items.length];
    next?.focus();
  }

  /* Light dismiss (Escape, outside click) closes the popover without going
     through openMenu, so aria-expanded and the scroll listeners are settled
     on the popover's own toggle event instead. */
  function bindMenus() {
    document.querySelectorAll<HTMLElement>("[data-theme-menu]").forEach((menu) => {
      if (menu.dataset.themeBound) return;
      menu.dataset.themeBound = "true";
      const reposition = () => place(menu);
      menu.addEventListener("toggle", (event) => {
        const open = (event as ToggleEvent).newState === "open";
        triggerOf(menu)?.setAttribute("aria-expanded", String(open));
        if (open) {
          addEventListener("scroll", reposition, { passive: true, capture: true });
          addEventListener("resize", reposition);
        } else {
          removeEventListener("scroll", reposition, { capture: true });
          removeEventListener("resize", reposition);
        }
      });
    });
  }

  function closeAll() {
    document
      .querySelectorAll<HTMLElement>("[data-theme-menu]")
      .forEach((menu) => menu.hidePopover());
  }

  syncTheme();
  bindMenus();

  document.addEventListener("astro:before-swap", closeAll);
  document.addEventListener("astro:after-swap", () => {
    syncTheme();
    bindMenus();
  });

  /* Event delegation — survives ClientRouter DOM swaps */
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const option = target.closest<HTMLElement>("[data-theme-option]");
    if (option) {
      const theme = option.dataset.themeOption;
      if (isThemeName(theme ?? null)) applyTheme(theme as ThemeName);
      closeAll();
      triggerOf(option.closest("[data-theme-menu]")!)?.focus();
      return;
    }

    const trigger = target.closest("[data-theme-select]");
    if (!trigger) return;
    const menu = menuOf(trigger);
    if (!menu) return;
    if (menu.matches(":popover-open")) menu.hidePopover();
    else openMenu(menu);
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const option = target.closest<HTMLElement>("[data-theme-option]");
    if (!option) return;
    const menu = option.closest<HTMLElement>("[data-theme-menu]");
    if (!menu) return;
    if (event.key === "ArrowDown") moveFocus(menu, option, 1);
    else if (event.key === "ArrowUp") moveFocus(menu, option, -1);
    else return;
    event.preventDefault();
  });
</script>
