---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import CornerDiamond from "@/components/ui/CornerDiamond";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/lib/config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: "website" | "profile" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /* Path to a plain-markdown twin of this page. Retrieval agents that find it
     fetch the clean source instead of parsing the rendered HTML. */
  markdownPath?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
  image = SITE.socialImage,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  keywords,
  structuredData,
  markdownPath,
} = Astro.props;

const buildCommit = import.meta.env.PUBLIC_GIT_COMMIT_HASH || "dev";
const buildDate = import.meta.env.PUBLIC_BUILD_DATE || new Date().toISOString();
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        try {
          const themes = ["dark", "light", "nightingale"];
          const root = document.documentElement;
          const saved = localStorage.getItem("theme");
          const theme = themes.includes(saved) ? saved : "dark";

          if (theme === "light") root.removeAttribute("data-theme");
          else root.setAttribute("data-theme", theme);

          if (!window.__themeSwapBound) {
            window.__themeSwapBound = true;
            document.addEventListener("astro:before-swap", function (e) {
              const s = localStorage.getItem("theme");
              const t = themes.includes(s) ? s : "dark";
              if (t === "light") e.newDocument.documentElement.removeAttribute("data-theme");
              else e.newDocument.documentElement.setAttribute("data-theme", t);
            });
          }
        } catch {
          document.documentElement.style.backgroundColor = "#EBE5D8";
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EBE5D8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1115" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/xd-32x32-light.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/xd-32x32-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/xd-32x32-light.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/xd-32x32-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}

    <link rel="preload" href="/fonts/Inter-Subset.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: Latin Modern Roman;
        src: url(/fonts/LatinModernRoman-Regular.woff2) format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: optional;
      }
      @font-face {
        font-family: Latin Modern Roman;
        src: url(/fonts/LatinModernRoman-Bold.woff2) format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: optional;
      }
      @font-face {
        font-family: Inter;
        src: url(/fonts/Inter-Subset.woff2) format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: optional;
      }
      @font-face {
        font-family: Inter;
        src: url(/fonts/Inter-Subset-Bold.woff2) format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: optional;
      }
      /* Subsets, not the 31KB variable file: printable ASCII plus the site's
         handful of specials (· — → ⌘ ⌥ ⌃ ⇧ ✦), no ligatures — 5KB a weight.
         The full variable font in the mono stack measured +300ms FCP and was
         the difference between 99 and 100. Regenerate with scripts noted in
         the commit that introduced these. */
      @font-face {
        font-family: JetBrains Mono;
        src: url(/fonts/JetBrainsMono-Subset.woff2) format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: optional;
      }
      @font-face {
        font-family: JetBrains Mono;
        src: url(/fonts/JetBrainsMono-Subset-Bold.woff2) format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: optional;
      }
    </style>

    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
      structuredData={structuredData}
    />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased">
    <div class="paper-background min-h-dvh overflow-x-clip" tabindex="-1">
      <div class="mx-auto max-w-5xl">
        {
          /* The page's outer frame is accent/30, one rung above the accent/20
            of Panel edges and SectionDividers — the boundary of the sheet
            should read stronger than the rules drawn inside it. This only
            holds if it is painted once: a Panel that sits flush against main
            must yield the shared edge (edges="bottom" on the first, "top" on
            the last), or the two 20%/30% lines composite and that one edge
            comes out darker than the rails beside it. */
        }
        <main
          class="edge-glow-shell edge-glow-shell-vertical bg-card border-accent/30 before:bg-accent/30 after:bg-accent/30 relative isolate mb-(--footer-height) min-h-screen border-x before:absolute before:top-0 before:right-[-9999px] before:left-[-9999px] before:z-10 before:h-px before:content-[''] after:absolute after:right-[-9999px] after:bottom-0 after:left-[-9999px] after:z-10 after:h-px after:content-['']"
        >
          <div class="edge-glow-layer" aria-hidden="true"></div>
          {
            /* Glow strips on main's own full-bleed top/bottom hairlines —
              the vertical wash only covers the left/right borders. At z-20 they
              sit above the base hairlines (z-10) they light, and below the
              corner diamonds (also z-20, later in the DOM), which stay opaque
              rather than getting a lit line drawn across their faces. */
          }
          <div
            class="edge-glow-line absolute top-0 right-[-9999px] left-[-9999px] z-20 h-px"
            aria-hidden="true"
          >
          </div>
          <div
            class="edge-glow-line absolute right-[-9999px] bottom-0 left-[-9999px] z-20 h-px"
            aria-hidden="true"
          >
          </div>
          <CornerDiamond position="all" variant="frame" />
          <slot />
        </main>
      </div>
      <Footer commit={buildCommit} buildDate={buildDate} />
    </div>

    <script is:inline src="/hero-interactions.js" defer></script>
    <script is:inline src="/edge-glow.js" defer></script>
    <script is:inline>
      (() => {
        const installBeacon = () => {
          if (document.querySelector("script[data-cf-beacon]")) return;

          const script = document.createElement("script");
          script.type = "module";
          script.src = "https://static.cloudflareinsights.com/beacon.min.js";
          script.setAttribute("fetchpriority", "low");
          script.setAttribute(
            "data-cf-beacon",
            JSON.stringify({ token: "e7a6cc938bc9460ab6216b1734501e83" }),
          );
          script.crossOrigin = "anonymous";
          document.head.append(script);
        };

        const scheduleBeacon = () => window.setTimeout(installBeacon, 0);

        if (document.readyState === "complete") {
          scheduleBeacon();
        } else {
          window.addEventListener("load", scheduleBeacon, { once: true });
        }
      })();
    </script>
  </body>
</html>
