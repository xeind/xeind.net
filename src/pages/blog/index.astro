---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Panel from "@/components/ui/Panel";
import SectionDivider from "@/components/ui/SectionDivider";
import Badge from "@/components/ui/Badge";
import { DashedBorders, GradientBackground } from "@/components/ui/frame";
import { SITE, absoluteUrl } from "@/lib/config/site";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const blogStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": absoluteUrl("/blog/#blog"),
  name: `${SITE.name} Blog`,
  description: "Notes and articles from Xein Deniel.",
  url: absoluteUrl("/blog"),
  inLanguage: SITE.language,
  isPartOf: { "@id": absoluteUrl("/#website") },
  author: {
    "@type": "Person",
    "@id": absoluteUrl("/#person"),
    name: SITE.name,
    url: SITE.url,
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": absoluteUrl(`/blog/${post.id}/#article`),
    headline: post.data.title,
    url: absoluteUrl(`/blog/${post.id}`),
    datePublished: post.data.date.toISOString(),
    description: post.data.excerpt,
    author: { "@id": absoluteUrl("/#person") },
  })),
};
---

<Layout
  title="Blog | Xein Deniel"
  description="Notes and articles from Xein Deniel."
  canonicalPath="/blog"
  markdownPath="/blog.md"
  structuredData={blogStructuredData}
>
  {
    /* min-h-screen matches main's own, so the stack fills the frame even with
      few posts, and the list panel takes up the slack. Without it the trailing
      divider and the Home row float mid-sheet with bare card beneath them —
      and a divider cannot close that gap, since it draws no lines of its own
      and there is nothing below it to light. */
  }
  <div class="flex min-h-screen flex-col">
    <Panel edges="bottom" ornaments="bottom" className="flex-1">
      {
        posts.length === 0 ? (
          <p class="text-foreground/80 font-serif text-base leading-8">No posts yet.</p>
        ) : (
          /* Two across at the cap, not three. The content column is 896 (56
             cells), and only a few splits divide it into whole cells with a
             whole-cell gap: 2 × 432 + 32, or 3 × 288 + 16. A post card
             carries a date, a serif title and an excerpt. 432 (27 cells)
             takes 54 characters to the line, so the longest excerpt on the
             site lands in three. At 288 the same text needs five, and the
             card grows taller than it is wide — a row of them reads as three
             columns of paragraphs rather than as cards.

             The split waits for `lg`, which is where the column reaches its
             896 cap. Splitting earlier makes both the width and the height
             lie: measured at 900px the column is 757, so two cards come out
             362.5 wide and the second one starts on a half pixel, and the
             narrower measure wraps a title onto a second line that a fixed
             height then clips. Below `lg` one card per row, sized by its own
             content — there is no neighbour to stay level with. */
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
            {posts.map((post) => (
              /* 240 — 15 cells. Every card is the same height, so a row's
                 bottom edge lands on a grid line instead of following
                 whichever excerpt wrapped longest. The tallest content a card
                 may hold is a two-line title over a three-line excerpt:
                 16 pad + 24 date + 48 title + 16 + 72 excerpt + 16 + 24 tags
                 + 16 pad = 232, measured. 240 is the next whole cell, and
                 mt-auto spends the 8 as air above the tags. Title and excerpt
                 are therefore layout — their caps are in docs/content.md,
                 where check:design reads them. */
              <a
                href={`/blog/${post.id}`}
                class="group bg-card focus-visible:ring-accent focus-visible:ring-offset-background relative flex flex-col overflow-hidden text-left transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none lg:h-60"
                data-hero-sfx="click"
                data-hero-sfx-hover
              >
                {/* Dashed border only. Corner brackets are reserved for cards
                    that open the centre modal, and this one navigates. */}
                <DashedBorders />
                <GradientBackground flash={false} />

                <div class="relative flex flex-1 flex-col p-4">
                  <time
                    datetime={post.data.date.toISOString()}
                    class="text-accent mb-2 block font-mono text-[0.6875rem] leading-4 tracking-wide tabular-nums"
                  >
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <h2 class="text-foreground group-hover:text-tertiary font-serif text-lg leading-6 [text-wrap:balance] transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-foreground/60 mt-4 text-xs leading-6 [text-wrap:pretty] lg:text-sm">
                    {post.data.excerpt}
                  </p>
                  {/* mt-auto pins the tags to the bottom edge, so a two-line
                      excerpt and a three-line one still share a tag baseline
                      across the row. */}
                  {post.data.tags.length > 0 && (
                    <div class="mt-auto flex flex-wrap gap-2 pt-4">
                      {post.data.tags.map((tag) => (
                        <Badge>{tag}</Badge>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </Panel>
    <SectionDivider variant="grid" />

    <Panel edges="top" ornaments="top">
      {/* h-6: caps the link's pb-px + underline border at one 24px line. */}
      <div class="flex h-6 items-center">
        <a
          href="/"
          data-hero-sfx="click"
          class="text-accent hover:text-tertiary border-accent/30 inline border-b border-dashed pb-px text-sm leading-6 transition-colors hover:border-solid"
        >
          &larr; Home
        </a>
      </div>
    </Panel>
  </div>
</Layout>
