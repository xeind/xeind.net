---
import Layout from "../layouts/Layout.astro";
import Panel from "@/components/ui/Panel";
import SectionDivider from "@/components/ui/SectionDivider";
import LoadingState from "@/components/lab/LoadingState";
import PixelGridSet from "@/components/lab/PixelGridSet";
import StreamingText from "@/components/lab/StreamingText";
import ThinkingTrace from "@/components/lab/ThinkingTrace";
import ApprovalCard from "@/components/lab/ApprovalCard";
import TaskRows from "@/components/lab/TaskRows";
import DiffBlock from "@/components/blog/DiffBlock.astro";
import { APPROVAL, STREAMED_ANSWER } from "@/lib/data/lab";

/* Agent-interface specimens, drawn in this site's system rather than the
   soft-card vocabulary these components usually arrive in.

   All six islands are client:visible: they sit down the page, and hydrating
   them on arrival would compete with the view transition (docs/animation.md
   §5). The rootMargin matches the home page's grids.

   docs/building.md rejects pulsing dots and typing cursors as decorative.
   That reject holds everywhere a reader is reading. Here the motion is the
   subject — this page is a specimen sheet, the same standing /design has. */
const hydrate = { rootMargin: "300px" };
---

<Layout
  title="Lab | Xein Deniel"
  description="Agent-interface specimens drawn in this site's design system."
  canonicalPath="/lab"
  noindex
>
  <div class="flex flex-col">
    <Panel padding="lg" edges="bottom" ornaments="bottom">
      <h1 class="text-foreground mb-4 font-serif text-2xl">Lab</h1>
      <p class="text-foreground/70 max-w-2xl text-sm leading-relaxed">
        Interface pieces for software that thinks out loud — waiting, streaming, reasoning, asking
        permission, reporting back. Every one is drawn in this site's ink: hairlines, dashed
        borders, mono figures, sharp corners and no status colors. They share one fictional run, so
        the page reads as a single interface caught at five moments.
      </p>
    </Panel>

    <SectionDivider />

    <Panel>
      <h2 class="text-accent mb-2 font-mono text-xs tracking-wide">WAITING</h2>
      <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
        Agent work has no known end, so a progress bar would be a lie. The grid says the work is
        alive; the timer says how long you have been waiting. Neither claims to know how much is
        left.
      </p>
      <LoadingState client:visible={hydrate} />

      <div class="border-accent/20 mt-8 border-t border-dashed pt-6">
        <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
          Nine cells, opacity only, no color and no movement — so the whole vocabulary is which cell
          is lit and when. Four patterns fit in that, and each says something different about the
          wait.
        </p>
        <PixelGridSet client:visible={hydrate} />
      </div>

      <div class="border-accent/20 mt-8 border-t border-dashed pt-6">
        <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
          The same four at 6×6. Every pattern is a function of the grid size, so this is one
          resolution of the same idea, not a second set of numbers — and each sweep slows in
          proportion, because there are more cells to cross.
        </p>
        <PixelGridSet size={6} client:visible={hydrate} />
      </div>
    </Panel>

    <SectionDivider variant="grid" />

    <Panel>
      <h2 class="text-accent mb-2 font-mono text-xs tracking-wide">STREAMING</h2>
      <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
        A word at a time, not a character at a time. Whole words let you start reading the first
        line while the third is still arriving — chasing a character cursor is watching, not
        reading.
      </p>
      <StreamingText text={STREAMED_ANSWER} client:visible={hydrate} />
    </Panel>

    <SectionDivider variant="grid" />

    <Panel>
      <h2 class="text-accent mb-2 font-mono text-xs tracking-wide">REASONING</h2>
      <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
        The trace is evidence, not content, so it rests collapsed. The summary line carries the
        total; only a reader who doubts the answer opens the rest.
      </p>
      <ThinkingTrace client:visible={hydrate} />
    </Panel>

    <SectionDivider variant="grid" />

    <Panel>
      <h2 class="text-accent mb-2 font-mono text-xs tracking-wide">APPROVAL</h2>
      <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
        Two competing actions and one accent per theme, so they cannot be told apart by color. The
        primary action takes a solid border, the secondary a dashed one — the same grammar the rest
        of the site uses for resting against engaged.
      </p>
      <ApprovalCard client:visible={hydrate}>
        <DiffBlock lines={APPROVAL.diff} />
      </ApprovalCard>
    </Panel>

    <SectionDivider variant="grid" />

    <Panel edges="top" ornaments="top">
      <h2 class="text-accent mb-2 font-mono text-xs tracking-wide">STATE</h2>
      <p class="text-foreground/60 mb-6 max-w-2xl text-sm leading-relaxed">
        Status without status colors. Running, done and failed are three states, not a matched pair
        like a diff's two, so there is no palette to borrow — state rides on the marker, the rail
        and the spelled-out word instead. The word is doing the real work; the rest lets you scan
        the column.
      </p>
      <TaskRows client:visible={hydrate} />
    </Panel>
  </div>
</Layout>
